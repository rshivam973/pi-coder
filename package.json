{
  "name": "pi-coder",
  "version": "0.1.0",
  "description": "Interactive, skill-driven coding agent CLI that runs inside a sandbox: clones a repo, implements a task with a pluggable LLM, validates, self-reviews, and opens a PR.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "pi-coder": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/pi-coder"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "@octokit/rest": "^21.1.1",
    "ai": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "msw": "^2.14.6",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
